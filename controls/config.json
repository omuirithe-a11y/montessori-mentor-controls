{
  "version": 1,
  "about": "Settings for the automatic checks. Plain-English explanation: docs/PREVIEW-FOR-YOU.md",
  "search_scope": "turn",
  "required_places": [
    "Files",
    "Artifacts",
    "Claude docs",
    "Chats",
    "Project",
    "Project instructions",
    "Memory (project notes)",
    "Account memory and preferences",
    "Skills and plugins",
    "Folders",
    "Working area (workspace)",
    "Google Drive"
  ],
  "extra_places": [
    "Records",
    "Live website",
    "Other GitHub repositories",
    "Other Drive folders",
    "Connected Mac folders",
    "Git history"
  ],
  "search_tool": "tools/search.py",
  "settled_path": "controls/settled.json",
  "records_dir": "records",
  "quote_min_words": 5,
  "strong_single_word_max_hits": 50,
  "not_found_regex": "(?i)\\b(nothing (was |is |has been )?found|found nothing|no (record|records|note|notes|file|files|match|matches|mention|mentions|result|results|hit|hits)( of| for| about| on| in)?\\b|not (in|among|anywhere in) the (files|records|notes|repository)|(nowhere|not) (in|on) (the )?(record|file))\\b",
  "records_claim_regex": "(?i)\\b(START-HERE|PROJECT-INSTRUCTIONS|the records?|the notes?|the settled list|settled\\.json|config\\.json)\\b[^.\\n]{0,40}\\b(says?|said|shows?|showed|holds?|held|records?|recorded|lists?|listed|states?|stated|confirms?)\\b",
  "unavailable_reasons_allowed": [
    "not offered in this session",
    "tool call failed",
    "not linked to this computer",
    "blocked by a control",
    "no doc exists to open"
  ],
  "reason_only_for": {"no doc exists to open": ["Claude docs"]},
  "max_blocks_per_reply": 60,
  "page_dir_regex": "(^|/)pages?/",
  "choice_admission_regex": "(?i)\\b(I (chose|decided|assumed|picked|went with|took (this|that|it) to mean)|my reading)\\b",
  "gate_always_allowed": [0, 1, 100],
  "gate_spacing_properties": "margin|margin-top|margin-bottom|margin-left|margin-right|padding|padding-top|padding-bottom|padding-left|padding-right|gap|row-gap|column-gap|line-height|font-size|width|height|min-width|min-height|max-width|max-height|text-indent|letter-spacing|top|bottom|left|right",
  "conflict_context_regex": "(?i)\\b(above|below|apart|wide|high|tall|indent|indented|spacing|space|between|px)\\b",
  "ceiling_extra_blocks": 5,
  "min_drive_queries_for_not_found": 3,
  "cloud_unavailable_places": [
    "Chats",
    "Project",
    "Memory (project notes)",
    "Account memory and preferences",
    "Folders"
  ],
  "file_claim_verbs_regex": "(?i)\\b(made|created|built|wrote|written|saved|generated|produced)\\b",
  "file_claim_negation_regex": "(?i)\\b(not|no|never|didn'?t|can'?t|cannot|couldn'?t|won'?t|haven'?t|hasn'?t|isn'?t|aren'?t|wasn'?t|nothing|unable|without|unless|if)\\b",
  "file_claim_extensions": "docx|doc|pdf|xlsx|pptx|html|htm|md|json|py|csv|txt|zip|png|jpg|jpeg|sh|patch",
  "claim_reviewer": {
    "enabled": true,
    "command": ["claude", "-p", "--model", "haiku", "--no-session-persistence", "--disable-slash-commands"],
    "timeout_seconds": 90,
    "max_blocks_per_reply": 2,
    "result_chars": 2500,
    "log_chars_total": 120000,
    "note": "A second model reads the reply and this turn's tool log and names claims the log does not support. If it cannot run, the reply is not blocked on its account (it is logged)."
  },
  "stop_excuse_regex": "(?i)(\\bI (will |'ll |must |have to )?stop here\\b|\\b(gate|hook|hooks|check|checks|control|controls) (has |have )?(stopped|blocked|prevented|refused) me\\b|\\bI (can'?t|cannot|am unable to|am not able to) (go on|continue|proceed|carry on)\\b|\\bI have stopped\\b|\\bfull stop\\b)",
  "forbidden_extensions": [
    ".docx",
    ".doc",
    ".dotx",
    ".pdf",
    ".pptx",
    ".xlsx",
    ".zip",
    ".tar",
    ".gz",
    ".7z",
    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".webp",
    ".heic",
    ".jp2",
    ".tif",
    ".tiff",
    ".psd",
    ".mp4",
    ".mov",
    ".mp3",
    ".wav"
  ],
  "max_file_bytes": 1000000,
  "repo_warn_bytes": 100000000,
  "repo_block_bytes": 500000000,
  "original_extensions": [
    ".docx",
    ".doc",
    ".dotx",
    ".pdf",
    ".pptx",
    ".xlsx",
    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".webp",
    ".heic",
    ".jp2",
    ".tif",
    ".tiff",
    ".psd"
  ],
  "work_copy_folder_names": [
    "work",
    "copy",
    "copies",
    "preview",
    "previews"
  ],
  "protected_control_paths": [
    ".claude/",
    "controls/",
    "tools/",
    "tests/",
    ".github/",
    "CLAUDE.md"
  ],
  "locked_paths": [
    ".session/",
    ".claude/settings.local.json"
  ],
  "publish_tool_name_regex": "(?i)(hostinger|ftp|deploy|wordpress|wp_)",
  "publish_bash_regex": "(?i)(\\b(sftp|scp|ftp|lftp|rsync)\\b|\\bwp\\s+(plugin|theme|post|media)\\b|\\bgh\\s+(release|workflow\\s+run|pages)\\b|curl[^|;&]*\\s(-T|--upload-file|-F|--form)\\b)",
  "hostinger_words_regex": "(?i)hostinger",
  "hostinger_with_regex": "(?i)(\\b(scp|sftp|ftp|rsync|curl|wget|ssh|upload)\\b)",
  "push_words_regex": "(?i)\\b(github|push|commit|pull request|PR)\\b",
  "go_regex": "(?i)^\\s*go[\\s.!]*$",
  "gate_exempt_tools_regex": "^(Read|Glob|Grep|WebSearch|WebFetch|ToolSearch|TaskCreate|TaskUpdate|TaskList|TaskGet|SendUserMessage|AskUserQuestion|Skill)$",
  "read_tool_name_regex": "(?i)(get|list|read|search|query|find|fetch|describe|preview|status|check|current_time|location|weather|display|show|inline_preview|summarize|properties|metadata|details|styles|recommend|palette|suggest)",
  "change_tool_name_regex": "(?i)(create|update|delete|trash|share|write|send|commit|publish|upload|add_|_add|set_|batch|move|copy|put|post|fire|remove|rename|save|append|replace|str_replace|invite|migrate|finalize|initialize|activate|render|export|convert|merge|fill|apply|adjust|crop|vectorize|animate|generate|combine|compress|split|rotate|redact|reorder|organize)",
  "claim_words_regex": "(?i)\\b(checked|verified|confirmed|matches|matched|measured|tested|looked at|all done|is done|are done|completed?|fixed|passes|passed)\\b",
  "start_here": {
    "copy_path": "controls/START-HERE.md",
    "note": "START-HERE lives in this repository only. It is not kept in Google Drive."
  },
  "context_files": [
    "controls/START-HERE.md",
    "controls/PROJECT-INSTRUCTIONS.md"
  ],
  "measure_mode": "baseline_to_capheight",
  "measure_mode_options": [
    "ink_to_ink",
    "baseline_to_capheight"
  ],
  "measure_mode_confirmed_by_user": true,
  "measure_mode_note": "Owner's definition, 13 Oct 2026: letters to letters = the line the letters sit on to the top of the capitals below.",
  "baseline_tolerance_px": 0.5
}
